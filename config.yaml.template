# Canonical benchmark configuration template.
# Runnable profile names follow:
#   <dataset>_<engine>_<type>
#
# Internal helper bases remain non-canonical and are hidden from menus.

dataset:
  source: "beir/trec-covid"
  prepared_dir: "data/prepared"
  max_docs: 0
  keep_qrels_docs: true

embedding:
  provider: "openai"
  model: "openai/text-embedding-3-large"
  api_key: ""
  api_key_file: ""
  base_url: ""
  site_url: ""
  app_name: "trec-covid-bench"
  price_per_million_input_tokens: 0.0
  max_batch_texts: 32
  concurrency: 4
  retry_attempts: 5
  retry_backoff_seconds: 1.0
  timeout_seconds: 120

benchmark:
  limit: 100
  warmup_queries: 5
  repeats: 1
  concurrency: 1
  timeout_seconds: 60
  diagnostics_queries: 3

metrics:
  enabled: ["ndcg@10", "ndcg@20", "map@10", "mrr@10", "p@20", "recall@100", "latency", "qps", "error_rate"]
  ndcg_ks: [10, 20]
  map_k: 10
  mrr_k: 10
  precision_k: 20
  recall_k: 100

manticore:
  type: "manticore"
  host: "127.0.0.1"
  sql_port: 9306
  http_port: 9308
  user: ""
  password: ""
  fulltext_table: "trec_covid_manticore"
  vector_table: "trec_covid_manticore"
  vector_field: "embedding"
  vector_from: "title,abstract"
  vector_similarity: "cosine"
  vector_quantization: ""
  vector_search_oversampling:
  vector_search_rescore:
  vector_cache_path: "vector_cache/trec-covid-openai.sqlite"
  vector_cache_fetch_batch_size: 1000
  index_layout: "combined"
  fulltext_options: "morphology='stem_en' index_field_lengths='1'"
  search_options: "ranker=expr('1000*bm25a(1.2,0.75)')"
  fulltext_query_mode: "or"
  # Legacy/non-TREC query_short/query_long selector. TREC-COVID run-matrix
  # entries use their explicit query/question/narrative logical dataset instead.
  fulltext_query_variant: "long"
  fulltext_query_quorum: 0.5
  batch_size: 2000
  index_concurrency: 1
  insert_retries: 3
  connect_timeout_seconds: 10
  query_timeout_seconds: 60

manticore_vector_1bit:
  base: "manticore"
  type: "vector"
  vector_quantization: "1bit"
  vector_search_oversampling: 3.0
  vector_search_rescore: 1
  batch_size: 250
  query_timeout_seconds: 180
  search_options: ""

qdrant:
  type: "qdrant"
  path: ""
  host: "127.0.0.1"
  port: 6333
  api_key: ""
  https: false
  timeout_seconds: 60
  batch_size: 2000
  index_concurrency: 1
  # combined: bm25_collection and dense_collection name one collection;
  # index it with the hybrid build to retain both vector spaces.
  index_layout: "combined"
  dense_collection: "trec_covid_qdrant"
  bm25_collection: "trec_covid_qdrant"
  dense_vector_name: "dense"
  sparse_vector_name: "bm25"
  dense_binary_quantization: false
  dense_binary_always_ram: true
  dense_binary_query_encoding: "default"
  dense_search_quantization_rescore:
  dense_search_quantization_oversampling:
  dense_search_quantization_ignore: false
  # Native Query API RRF. Qdrant k=61 matches classic one-based RRF with k=60.
  hybrid_rrf_k: 61
  hybrid_sparse_weight: 1.0
  hybrid_dense_weight: 1.0
  hybrid_candidates: 200

qdrant_vector_1bit:
  base: "qdrant"
  type: "vector"
  dense_binary_quantization: true
  dense_binary_always_ram: true
  dense_search_quantization_rescore: true
  dense_search_quantization_oversampling: 3.0
  batch_size: 500

qdrant_hybrid_1bit:
  base: "qdrant_vector_1bit"
  type: "hybrid"

meilisearch:
  type: "meilisearch"
  host: "http://127.0.0.1:7700"
  api_key: ""
  api_key_file: ""
  index_name: "trec_covid_meilisearch"
  index_layout: "combined"
  timeout_sec: 30
  batch_size: 1000
  index_concurrency: 1
  searchable_attributes: ["title", "abstract"]
  ranking_rules: ["words", "typo", "proximity", "attribute", "sort", "exactness"]
  stop_words: []
  synonyms: {}
  typo_tolerance: true
  embedder_name: "default"
  vector_index: "vector"
  hybrid_semantic_ratio: 0.5
  binary_quantized: false

meilisearch_vector_1bit:
  base: "meilisearch"
  type: "vector"
  binary_quantized: true
  batch_size: 250

meilisearch_hybrid_1bit:
  base: "meilisearch_vector_1bit"
  type: "hybrid"

opensearch:
  type: "opensearch"
  url: "http://127.0.0.1:9200"
  username: ""
  password: ""
  api_key: ""
  api_key_file: ""
  verify_certs: false
  timeout_sec: 30
  batch_size: 500
  index_concurrency: 1
  index_name: "trec_covid_opensearch"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  vector_index: "vector"
  vector_field: "embedding"
  space_type: "cosinesimil"
  # Relative weights for native RRF; OpenSearch normalizes them to sum to 1.
  hybrid_text_boost: 1.0
  hybrid_vector_boost: 1.0
  hybrid_rrf_k: 60
  hybrid_candidates: 200

elasticsearch:
  type: "elasticsearch"
  url: "http://127.0.0.1:9201"
  username: ""
  password: ""
  api_key: ""
  api_key_file: ""
  verify_certs: false
  timeout_sec: 30
  batch_size: 500
  index_concurrency: 1
  index_name: "trec_covid_elasticsearch"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  vector_field: "embedding"
  similarity: "cosine"
  hybrid_text_boost: 1.0
  hybrid_vector_boost: 1.0

typesense:
  type: "typesense"
  url: "http://127.0.0.1:8108"
  api_key: "xyz"
  api_key_file: ""
  timeout_sec: 30
  batch_size: 500
  index_concurrency: 1
  collection_name: "trec_covid_typesense"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  vector_field: "embedding"
  vector_distance: "cosine"
  hybrid_alpha: 0.5

milvus:
  type: "milvus"
  uri: "http://127.0.0.1:19530"
  token: ""
  token_file: ""
  database: "default"
  timeout_seconds: 60
  batch_size: 500
  index_concurrency: 1
  collection_name: "trec_covid_milvus"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  content_field: "content"
  doc_id_max_length: 2048
  dense_vector_field: "embedding"
  sparse_vector_field: "sparse"
  dense_index_type: "AUTOINDEX"
  dense_metric_type: "COSINE"
  dense_index_params: {}
  dense_search_params: {}
  sparse_index_algorithm: "DAAT_MAXSCORE"
  sparse_drop_ratio_search: 0.0
  bm25_k1: 1.2
  bm25_b: 0.75
  hybrid_rrf_k: 60
  hybrid_candidates: 400
  consistency_level: "Strong"

mariadb:
  type: "mariadb"
  host: "127.0.0.1"
  port: 3307
  user: "bench"
  password: "bench"
  database: "search_quality_benchmark"
  table_name: "trec_covid_mariadb"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  vector_field: "embedding"
  vector_distance: "cosine"
  vector_m: 8
  fulltext_search_mode: "natural"
  # Hybrid fusion runs entirely in one server-side SQL statement. Alpha is the
  # vector weight; the full-text branch uses 1-alpha.
  hybrid_alpha: 0.5
  hybrid_rrf_k: 60
  hybrid_candidates: 400
  batch_size: 100
  index_concurrency: 1
  connect_timeout_seconds: 10
  query_timeout_seconds: 60
  index_timeout_seconds: 3600
  index_progress_interval_seconds: 5

serenedb:
  type: "serenedb"
  host: "127.0.0.1"
  port: 7890
  user: "postgres"
  password: "bench"
  database: "postgres"
  table_name: "trec_covid_serenedb"
  index_layout: "combined"
  text_fields: ["title", "abstract"]
  # Fraction of whitespace-delimited query terms that must match. SereneDB
  # accepts an integer min_match, which the client derives with ceil().
  # The bundled 10% avoids a SereneDB 26.10.1 crash on wide OR queries.
  fulltext_min_match_ratio: 0.1
  vector_field: "embedding"
  vector_metric: "cosine"
  vector_index_type: "ivf"
  vector_quantization: "sq8"
  # "exact" scans the base table; "index" queries the configured ANN index.
  # Bundled profiles use exact because SereneDB 26.10.1 crashes on repeated
  # 4096-dimensional ANN queries.
  vector_query_mode: "exact"
  vector_search_nprobe: 8
  vector_rerank_factor: 4
  hybrid_alpha: 0.5
  hybrid_rrf_k: 60
  hybrid_candidates: 400
  batch_size: 500
  index_concurrency: 1
  connect_timeout_seconds: 10
  query_timeout_seconds: 60

weaviate:
  type: "weaviate"
  url: "http://127.0.0.1:8080"
  api_key: ""
  api_key_file: ""
